# Copy this file to .env. The dashboard starts without credentials.
# To enable GitHub reviews, uncomment and fill in these values, and put your
# GitHub App private key in secrets/private-key.pem.
# MIRA_GITHUB_APP_ID=123456
# MIRA_GITHUB_PRIVATE_KEY=@/run/secrets/private-key.pem
# MIRA_WEBHOOK_SECRET=replace-with-your-webhook-secret
# OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Optional: set an initial admin password; otherwise Mira generates one.
# ADMIN_PASSWORD=

# Alternatively, configure GitLab and your LLM key:
# MIRA_GITLAB_TOKEN=
# MIRA_GITLAB_WEBHOOK_SECRET=
# MIRA_GITLAB_API_URL=https://gitlab.com/api/v4

# SQLite is persisted in the mira-data volume by default.
# For an external Postgres database, use a hostname reachable from the container.
# DATABASE_URL=postgresql://mira:password@database-host:5432/mira
